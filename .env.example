# AI API 配置
GEMINI_API_KEY=your_gemini_api_key_here
# 單一模型，每次發文只呼叫 1 次 generate_content（見 main.py 日誌說明）
# 免費層 RPM 較緊時可用 flash-lite；要較強文案可改 gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite
# 兩次 Gemini 請求至少間隔 N 秒（本機 0=關閉；GitHub Actions workflow 內預設 30）
GEMINI_MIN_SECONDS_BETWEEN_REQUESTS=0
# GEMINI_RATE_STATE_FILE=.gemini_rate_state

# X (Twitter) API 配置
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# 自動發文設定 (true/false)
AUTO_POST_TO_X=true